{
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath hooks",
    "dev": "tauri dev",
    "build": "tauri build",
    "conventions": "cargo run --quiet --package conventions",
    "rust:format": "cargo fmt --all --check",
    "rust:lint": "cargo clippy --workspace --all-targets --quiet -- --deny warnings",
    "ui:lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "ui:types": "bun run --cwd ui types",
    "icons:test": "bun test ./desktop/icons/tests/*.ts",
    "check": "bun run conventions && bun run rust:format && bun run rust:lint && cargo test --workspace --quiet && bun run ui:lint && bun run ui:types && bun run --cwd ui test && bun run icons:test && bun run --cwd ui build && sh budgets.sh javascript"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tauri-apps/cli": "^2.12.6"
  }
}
